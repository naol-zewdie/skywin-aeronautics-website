# ==========================================
# Skywin Server Environment Configuration
# ==========================================

# Application
NODE_ENV=development
PORT=3001

# Database
# Local: mongodb://127.0.0.1:27017/skywin
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/skywin?retryWrites=true&w=majority
DATABASE_URL=mongodb://127.0.0.1:27017/skywin
ENABLE_DB=true

# Authentication (JWT) - CRITICAL: Generate real secrets before deployment!
# Run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_RANDOM_128_CHAR_HEX_STRING
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_128_CHAR_HEX_STRING
JWT_REFRESH_EXPIRES_IN=7d

# Password Hashing
BCRYPT_ROUNDS=12

# CORS (comma-separated list of allowed origins — set to your production domains)
# Example: https://skywin.aero,https://admin.skywin.aero
CORS_ORIGIN=http://localhost:3000,http://localhost:3003

# Trust Proxy — set to "true" when behind a reverse proxy (Nginx, Cloudflare, etc.)
# Enables correct client IP resolution for rate limiting
TRUST_PROXY=false

# Cookies — COOKIE_SECURE controls the `Secure` flag on auth cookies.
# Default (unset): true in production, false in development.
# Override with COOKIE_SECURE=false ONLY if you serve the admin over plain HTTP
# (browsers drop Secure cookies on http://, which breaks the session/refresh flow).
# Set COOKIE_SECURE=true once TLS/HTTPS is in place.
# COOKIE_SECURE=false


# Frontend URL (used in password reset emails)
FRONTEND_URL=http://localhost:3003

# Password Reset
PASSWORD_RESET_EXPIRES_IN=1h

# Seed Script (required in production if running seed)
SEED_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# SMTP (Email) — REQUIRED in production for password reset emails
# Without SMTP configured, emails are silently dropped
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
SMTP_FROM=noreply@skywin.aero
