# Admin Dashboard Environment Variables
# Copy this to .env.local and fill in your values

# API Configuration (backend URL for Next.js proxy rewrites)
NEXT_PUBLIC_API_URL=http://localhost:3001

# App Configuration
NEXT_PUBLIC_APP_NAME=Skywin Admin
NEXT_PUBLIC_APP_VERSION=1.0.0

# JWT secret — must match Server JWT_SECRET for middleware role verification
JWT_SECRET=your_super_secret_64_character_minimum_length_jwt_secret_here