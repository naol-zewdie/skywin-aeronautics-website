# Skywin Aeronautics - Test Server Environment Configuration
# Copy this file to .env.test on your test server and fill in the values

# ---------------------------------------------------------
# MANDATORY: The public IP address of your test server
# Next.js NEEDS this at build time to know where the API is.
# Example: SERVER_IP=192.168.1.100
# ---------------------------------------------------------
SERVER_IP=YOUR_SERVER_IP_HERE

# ---------------------------------------------------------
# Security Secrets
# Generate random 64-character hex strings for these!
# e.g., node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ---------------------------------------------------------
JWT_SECRET=replace_with_your_random_64_byte_hex_secret
JWT_REFRESH_SECRET=replace_with_another_random_64_byte_hex_secret

# ---------------------------------------------------------
# External Services
# ---------------------------------------------------------
RESEND_API_KEY=your_resend_api_key_here
